# =========================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - LOG-ANALYZER-AGENT
# Copie este archivo como '.env.production' y rellene los valores reales
# NUNCA suba este archivo a repositorios de código
# =========================================================================

# -------------------------------------------------------------------------
# 1. INFRAESTRUCTURA Y CONECTIVIDAD OLLAMA
# -------------------------------------------------------------------------
# URL del servicio OLLAMA
# Opciones:
#   - Local (Docker): http://ollama:11434
#   - Host local (Windows): http://host.docker.internal:11434
#   - OLLAMA Cloud: https://api.ollama.com
#   - Remota: https://ollama.ejemplo.com:11434
OLLAMA_API_URL=https://api.ollama.com

# API Key para OLLAMA Cloud o servidores con autenticación
# Para OLLAMA Cloud: obtener de https://ollama.com/account/keys
# Para servidores locales: dejar vacío si no hay autenticación
# ⚠️ NUNCA compartir en control de versiones - usar .gitignore
OLLAMA_API_KEY=

# Nombre del modelo a utilizar
# OLLAMA Cloud: llama3.2:1b:cloud, llama3.1:8b:cloud, mixtral:8x7b:cloud
# Local: phi:2.7b, llama2:latest, neural-chat:7b
OLLAMA_MODEL=llama3.2:1b:cloud

# Modelo opcional exclusivo del orquestador. Si se omite, hereda OLLAMA_MODEL.
# ORCHESTRATOR_MODEL=llama3.2:1b:cloud
# ORCHESTRATOR_OLLAMA_API_KEY=  # Si se omite, hereda OLLAMA_API_KEY

# Timeout para las llamadas a OLLAMA (segundos)
OLLAMA_TIMEOUT=30

# Habilitar respuestas en streaming
ENABLE_STREAMING=true

# -------------------------------------------------------------------------
# 2. CONFIGURACIÓN FLASK
# -------------------------------------------------------------------------
# Entorno: production, development, staging
FLASK_ENV=production

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Puerto interno del contenedor (normalmente no cambiar)
PORT=5000

# -------------------------------------------------------------------------
# 3. CREDENCIALES SERVICENOW (Opcional - solo si integración requerida)
# -------------------------------------------------------------------------
# Subdominio de la instancia ServiceNow
SERVICENOW_INSTANCE=tu-instancia

# OAuth credentials (obtener de System OAuth -> Application Registry)
SERVICENOW_CLIENT_ID=tu_client_id
SERVICENOW_CLIENT_SECRET=tu_client_secret

# Credenciales de usuario API
SERVICENOW_USERNAME=api_user
SERVICENOW_PASSWORD=contraseña_segura

# -------------------------------------------------------------------------
# 4. POLÍTICAS DE GESTIÓN DE INCIDENTES
# -------------------------------------------------------------------------
# Activar creación de incidentes reales
SERVICENOW_CREATE_INCIDENTS=false

# Categoría de incidentes
SERVICENOW_INCIDENT_CATEGORY=Software

# Grupo de asignación (obtener sys_id de ServiceNow)
SERVICENOW_ASSIGNMENT_GROUP=

# Modo deduplicación: pattern, chain, all
SERVICENOW_DEDUP_MODE=pattern

# -------------------------------------------------------------------------
# 5. RECURSOS (Docker compose)
# -------------------------------------------------------------------------
# CPU
AGENT_CPU_LIMIT=2
AGENT_CPU_RESERVE=1

# Memoria
AGENT_MEMORY_LIMIT=2G
AGENT_MEMORY_RESERVE=1G

# Puerto expuesto
AGENT_PORT=5000
