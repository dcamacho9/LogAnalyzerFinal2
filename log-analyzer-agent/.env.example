# =========================================================================
# CONFIGURACIÓN DEL ENTORNO PARA LOG-ANALYZER-AGENT (PLANTILLA)
# =========================================================================
# Copie este archivo como '.env' y rellene los valores reales.
# NUNCA suba el archivo '.env' final a repositorios de código.

# -------------------------------------------------------------------------
# 1. INFRAESTRUCTURA Y CONECTIVIDAD OLLAMA
# -------------------------------------------------------------------------
# URL base del motor de inferencia local de Ollama (Por defecto: http://localhost:11434)
OLLAMA_API_URL=http://localhost:11434
# Nombre del modelo personalizado compilado a partir del Modelfile
MODEL_NAME=log-analyzer-agent

# -------------------------------------------------------------------------
# 2. CREDENCIALES Y ACCESO A SERVICENOW (SKILL: servicenow-token-generator)
# -------------------------------------------------------------------------
# Subdominio de la instancia de ServiceNow (Ejemplo: si la URL es miempresa.service-now.com, use 'miempresa')
SERVICENOW_INSTANCE=your-instance-subdomain

# Credenciales de la aplicación OAuth registrada en ServiceNow (System OAuth -> Application Registry)
SERVICENOW_CLIENT_ID=your_oauth_client_id_here
SERVICENOW_CLIENT_SECRET=your_oauth_client_secret_here

# Cuenta de usuario con permisos necesarios para consumir la Table API e inyectar incidentes
SERVICENOW_USERNAME=api_integration_user
SERVICENOW_PASSWORD=your_secure_user_password_here

# -------------------------------------------------------------------------
# 3. POLÍTICAS OPERATIVAS DE ITSM (SKILL: servicenow-incident-creator)
# -------------------------------------------------------------------------
# Interruptor global de acción: 'true' para abrir tickets reales, 'false' para modo simulación/solo lectura
SERVICENOW_CREATE_INCIDENTS=false

# Categoría por defecto bajo la cual se catalogarán los incidentes en la plataforma
SERVICENOW_INCIDENT_CATEGORY=Software

# (Opcional) Sys_id o nombre del grupo de soporte asignado automáticamente en ServiceNow (Ej. SRE_Team)
SERVICENOW_ASSIGNMENT_GROUP=sys_id_of_assignment_group_here

# Modo de deduplicación de incidentes por defecto a aplicar:
# - 'pattern': Agrupa por firma del error (SHA-256) evitando duplicar incidentes abiertos.
# - 'chain': Agrupa eventos bajo una misma cadena de falla usando correlationId en cascada.
# - 'all': Desactiva la deduplicación (Crea un ticket independiente por cada error).
SERVICENOW_DEDUP_MODE=pattern